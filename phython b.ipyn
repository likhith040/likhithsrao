      "source": [
        "import pandas as pd\n",
        "#create a series\n",
        "data=[10, 20,30,40]\n",
        "series=pd.Series(data, index=[11, 'bharth(','chris', \"disha\"])\n",
        "print(series)"
      ]
    },
